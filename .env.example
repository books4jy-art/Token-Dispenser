# 디스코드 개발자 포털 → Bot → Reset Token 으로 받은 봇 토큰
DISCORD_TOKEN=

# 입금 계좌를 쓰는 디스코드 서버 ID (서버 우클릭 → 서버 ID 복사)
DEPOSIT_GUILD_ID=

# 입금 알림 웹훅 비밀번호. 아무도 모르는 긴 문자열로 정하세요. (비우면 자동 입금 확인이 꺼져요)
WEBHOOK_SECRET=

# 웹훅을 열 주소. Cloudflare Tunnel을 쓰면 127.0.0.1 (서버 안에서만 접속 가능)
WEBHOOK_HOST=0.0.0.0

# 웹훅 포트 (호스팅 서비스가 PORT를 정해 주면 그 값이 쓰여요)
WEBHOOK_PORT=8080

# 충전 신청 후 입금을 기다리는 시간 (분)
CHARGE_EXPIRE_MINUTES=60

# 데이터베이스 파일 위치
DB_PATH=shop.db

# (선택) 명령어를 이 서버에 바로 등록 — 처음 설정할 때 편해요
DEV_GUILD_ID=

# (선택) 은행 알림을 못 읽을 때만: amount, name 그룹이 있는 정규식
# 예: 입금\s*(?P<amount>[\d,]+)원\s*(?P<name>\S+)
DEPOSIT_REGEX=
